# Copy this file to .env.local and fill in the key. Never commit .env or .env.local.
VITE_API_URL=https://omnimodel-api.onrender.com
VITE_API_KEY=your_api_key

# NOTE: anything prefixed VITE_ is bundled into browser code and is NOT secret.
# Fine for development and internal use. Before public deployment, put the key
# behind a small server-side proxy that adds the X-API-Key header.
